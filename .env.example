# Copy this file to .env (or .env.local) and fill in your Supabase project's
# values. .env / .env.local are already in .gitignore — never commit real
# values.
#
# Both variables must be set for src/net/rooms.js to use the real Supabase
# backend. If either is missing, the app falls back to the local
# localStorage-backed mock in src/net/mockRooms.js (isBackendConfigured()
# returns false).

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# The "anon" / "public" API key from Project Settings > API.
# This key is DESIGNED to be public (it ships inside the built frontend
# bundle) — that is only safe because supabase/schema.sql turns on Row Level
# Security with policies that restrict what the anon role can actually do.
# Do not substitute the service_role key here.
VITE_SUPABASE_ANON_KEY=

# Never set this in a frontend .env file, and never commit it anywhere:
# SUPABASE_SERVICE_ROLE_KEY grants full, RLS-bypassing access to the
# database. It has no VITE_ prefix on purpose — Vite only inlines
# VITE_-prefixed variables into the client bundle, so even naming it
# correctly would not stop it from leaking. It belongs only in
# server-side/admin tooling that never ships to a browser (e.g. a one-off
# maintenance script run locally), if it's needed at all.
